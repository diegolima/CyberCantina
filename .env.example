# ==============================================================================
# CyberCantina Docker Environment Configuration
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Port on the host machine to expose the CyberCantina web interface
PORT=3000

# Endpoint for Ollama running on your host machine.
# On Linux / macOS / Windows with Docker Desktop or Podman, host.docker.internal
# resolves to the host machine gateway.
# Make sure Ollama is listening on 0.0.0.0 (e.g. OLLAMA_HOST=0.0.0.0 ollama serve)
ACTOR_BASE_URL=http://host.docker.internal:11434/v1
CLERK_BASE_URL=http://host.docker.internal:11434/v1

# Optional symmetric key (base64 Fernet key) for encrypting provider credentials.
# If omitted, CyberCantina will auto-generate one on the persistent volume at
# /data/.cantina_secret.key.
# CYBERCANTINA_SECRET_KEY=
