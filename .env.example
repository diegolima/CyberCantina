# ==============================================================================
# CyberCantina Docker Environment Configuration
# Copy this file to .env and adjust values as needed.
# ==============================================================================

# Port on the host machine to expose the CyberCantina web interface
PORT=3000

# Endpoint for Ollama running on your host machine.
# On Linux / macOS / Windows with Docker Desktop or Podman, host.docker.internal
# resolves to the host machine gateway.
# Make sure Ollama is listening on 0.0.0.0 (e.g. OLLAMA_HOST=0.0.0.0 ollama serve)
ACTOR_BASE_URL=http://host.docker.internal:11434/v1
CLERK_BASE_URL=http://host.docker.internal:11434/v1

# Optional symmetric key (base64 Fernet key) for encrypting provider credentials.
# If omitted, CyberCantina will auto-generate one on the persistent volume at
# /data/.cantina_secret.key.
# CYBERCANTINA_SECRET_KEY=

# Session cookie Secure flag mode: auto (detect HTTPS/proxy headers), true, or false.
CYBERCANTINA_COOKIE_SECURE=auto

# Keep Swagger /docs and /openapi.json disabled by default on public deployments.
CYBERCANTINA_ENABLE_API_DOCS=false

# Emit Strict-Transport-Security when behind HTTPS (never emits over plain HTTP).
CYBERCANTINA_ENABLE_HSTS=false

# Set to true only when running behind Cloudflare proxy (trusts CF-Connecting-IP).
CYBERCANTINA_TRUST_CF_HEADERS=false

# Public URL sent in HTTP-Referer headers to OpenRouter/NanoGPT/AI Horde.
CYBERCANTINA_PUBLIC_URL=https://cybercantina.io

# Maximum uploaded package size in MB for /api/import/inspect.
CYBERCANTINA_MAX_IMPORT_UPLOAD_MB=100
